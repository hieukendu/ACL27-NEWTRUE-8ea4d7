# Keep project sources, manuscripts, manuals, experiment inputs/results, and
# all other reproducibility artefacts by default.

# Local environment files and environment directories.
.env
.env.*
*.env
!.env.example
.venv/
venv/
ENV/
env/

# OS, editor, and temporary metadata.
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.#*

# Tool caches and generated local metadata.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Private archive bookkeeping metadata.
/ARCHIVE_MANIFEST.json
/ARCHIVE_RECEIPT.json

# LaTeX build metadata (source, figures, PDFs, and experiment logs remain
# trackable).
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
